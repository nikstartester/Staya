<?xml version="1.0" encoding="utf-8"?><!--
   Правила автобэкапа для устройств до API 31.
   Начиная с API 31 используется data_extraction_rules.xml.

   Хранилище токенов исключено из бэкапа: keyset Tink зашифрован мастер-ключом
   из Android Keystore, а Keystore не бэкапится. При восстановлении на другом
   устройстве keyset вернулся бы без ключа и стал бы нечитаемым.
-->
<full-backup-content>
    <!-- Keyset Tink, которым шифруются токены -->
    <exclude
        domain="sharedpref"
        path="token_keyset_prefs.xml"/>
    <!-- DataStore с зашифрованными токенами -->
    <exclude
        domain="file"
        path="datastore/token_prefs.preferences_pb"/>
</full-backup-content>