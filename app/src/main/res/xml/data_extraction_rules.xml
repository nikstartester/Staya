<?xml version="1.0" encoding="utf-8"?><!--
   Правила бэкапа и переноса данных для API 31+.
   См. https://developer.android.com/about/versions/12/backup-restore#xml-changes

   Хранилище токенов исключено и из облачного бэкапа, и из переноса между
   устройствами: keyset Tink зашифрован мастер-ключом из Android Keystore,
   который не переносится. Без него keyset становится нечитаемым.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Keyset Tink, которым шифруются токены -->
        <exclude
            domain="sharedpref"
            path="token_keyset_prefs.xml"/>
        <!-- DataStore с зашифрованными токенами -->
        <exclude
            domain="file"
            path="datastore/token_prefs.preferences_pb"/>
    </cloud-backup>
    <device-transfer>
        <!-- Keyset Tink, которым шифруются токены -->
        <exclude
            domain="sharedpref"
            path="token_keyset_prefs.xml"/>
        <!-- DataStore с зашифрованными токенами -->
        <exclude
            domain="file"
            path="datastore/token_prefs.preferences_pb"/>
    </device-transfer>
</data-extraction-rules>